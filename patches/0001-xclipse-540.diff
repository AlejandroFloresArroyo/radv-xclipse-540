+                            pdev->info.xclipse_model == AC_XCLIPSE_940 ||
+                            pdev->info.xclipse_model == AC_XCLIPSE_540 ? 1 : 0);
       RADV_LOGI("[XCLIPSE] ctx_init=%d (model=%d, %u regs)", cached,
                 pdev->info.xclipse_model, (unsigned)ARRAY_SIZE(ac_xclipse_ctx_init));
