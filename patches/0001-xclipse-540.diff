+++ b/src/amd/common/ac_xclipse_log.h	2026-10-11 19:49:07.566056258 -0600
@@ -26,7 +26,7 @@
 }
 #endif
 
-#ifdef __ANDROID__
+#if 1 /* Linux: <android/log.h> comes from the glibc compat include dir */
 #include <android/log.h>
 
 /* __android_log_print, but free while the level is 0: the arguments are not even evaluated. */
diff -ru a/src/amd/vulkan/radv_queue.c b/src/amd/vulkan/radv_queue.c
